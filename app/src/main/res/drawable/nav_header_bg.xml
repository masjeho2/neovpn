<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#0A1A2A"
                android:startColor="#12182A"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:bottom="-40dp"
        android:left="-20dp"
        android:right="80dp"
        android:top="20dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00000000"
                android:gradientRadius="160dp"
                android:startColor="#3D00D9FF"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:bottom="10dp"
        android:left="80dp"
        android:right="-40dp"
        android:top="-50dp">
        <shape android:shape="oval">
            <gradient
                android:endColor="#00000000"
                android:gradientRadius="140dp"
                android:startColor="#336C63FF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
