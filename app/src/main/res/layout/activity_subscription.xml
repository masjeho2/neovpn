<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_dark"
        app:navigationIcon="@drawable/ic_back"
        app:title="Subscriptions"
        app:titleTextAppearance="@style/TextAppearance.NeoVPN.Toolbar"
        app:titleTextColor="@color/text_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_sub"
            style="@style/Widget.NeoVPN.ActionButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Add"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_paste_sub"
            style="@style/Widget.NeoVPN.ActionButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Paste URL"
            app:icon="@drawable/ic_paste"
            app:iconTint="@color/protocol_trojan" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_no_subs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No subscriptions yet.\nTap Add or Paste URL to begin."
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_subscriptions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:visibility="gone" />

</LinearLayout>
